# 后端 API 地址（必填）
NEXT_PUBLIC_API_URL=http://localhost:8000

# 后端 API 版本
NEXT_PUBLIC_API_VERSION=api/v1

# 登录接口路径（将拼接到 BASE_URL + API_VERSION 后）
NEXT_PUBLIC_AUTH_LOGIN_PATH=/auth/login

# Mock 用户 ID（可选，默认：user_demo_001）
NEXT_PUBLIC_MOCK_USER_ID=user_demo_001

# Skill Service（独立进程，默认 8001）
# 前端默认走同源 /skill-api（Next rewrites 代理），一般无需改 NEXT_PUBLIC_*。
# SKILL_SERVICE_URL=http://localhost:8001
# NEXT_PUBLIC_SKILL_API_PREFIX=/skill-api
# 生产若 skill-service 有独立域名，可设 NEXT_PUBLIC_SKILL_SERVICE_URL=https://skills.example.com

# 登录方式：logto（公网部署）| oa（企业内部部署）
# NEXT_PUBLIC_* 变量在构建期内联，由 Dockerfile 的 APP_ENV_FILE build arg 指定 env 文件
NEXT_PUBLIC_AUTH_PROVIDER=logto

# ---- 企业 OA 登录（NEXT_PUBLIC_AUTH_PROVIDER=oa 时使用）----
# OA SSO 授权地址（snsapi_base 静默授权）
NEXT_PUBLIC_OA_SSO_AUTHORIZE_URL=https://oasso.jiepei.com/connect/authorize
# OA 权限中台创建应用后拿到的 agentid
NEXT_PUBLIC_OA_AGENT_ID=your_oa_agent_id
# 回调地址需与 OA 应用中配置的一致；留空则回退为 {APP_URL}/callback
NEXT_PUBLIC_OA_REDIRECT_URI=http://localhost:4000/callback

# Logto 前端配置（NEXT_PUBLIC_AUTH_PROVIDER=logto 时使用）
NEXT_PUBLIC_APP_URL=http://localhost:4000
NEXT_PUBLIC_LOGTO_ENDPOINT=http://localhost:3001
NEXT_PUBLIC_LOGTO_APP_ID=your_logto_app_id
NEXT_PUBLIC_LOGTO_REDIRECT_URI=http://localhost:4000/callback
NEXT_PUBLIC_LOGTO_POST_LOGOUT_REDIRECT_URI=http://localhost:4000
NEXT_PUBLIC_LOGTO_SCOPES=openid profile email offline_access

# Skill Service配置（生产环境）
SKILL_SERVICE_URL=

# OA 中台单点登出端点（中台提供后启用；启用后登出会跳转清 OA 会话，重新登录需扫码）
# NEXT_PUBLIC_OA_SSO_LOGOUT_URL=https://oasso.jiepei.com/connect/logout
